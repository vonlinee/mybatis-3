<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.apache.ibatis.submitted.sql_render.Mapper">

    <select id="searchUsers" resultType="org.apache.ibatis.submitted.sql_render.User">
        SELECT
        id, name, email, status, age, created_at
        FROM users
        <where>
            <if test="statusList != null and statusList.size() > 0">
                AND status IN
                <foreach item="statusItem" collection="statusList" open="(" separator="," close=")">
                    #{statusItem}
                </foreach>
            </if>
            <if test="searchKeyword != null and searchKeyword != ''">
                <bind name="searchPattern" value="'%' + searchKeyword + '%'"/>
                AND (name LIKE #{searchPattern} OR email LIKE #{searchPattern})
            </if>
            <if test="registeredAfter != null">
                AND created_at &gt;= #{registeredAfter}
            </if>
            <if test="registeredBefore != null">
                AND created_at &lt;= #{registeredBefore}
            </if>
        </where>
        <choose>
            <when test="sortBy == 'nameAsc'">
                ORDER BY name ASC
            </when>
            <when test="sortBy == 'ageDesc'">
                ORDER BY age DESC
            </when>
            <when test="sortBy == 'newest'">
                ORDER BY created_at DESC
            </when>
            <otherwise>
                ORDER BY id ASC
            </otherwise>
        </choose>
    </select>

    <select id="searchUsersByStatus" resultType="org.apache.ibatis.submitted.sql_render.User">
        SELECT * FROM users WHERE status = #{status}
    </select>
</mapper>
